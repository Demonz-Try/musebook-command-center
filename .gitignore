# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — keep committed examples only
.env
.env.*
!.env.example
!**/.env.example

# never commit keys or Netlify local state
*.key
keystore
.netlify

# not this host
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local database
/.data
.netlify

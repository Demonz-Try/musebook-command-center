# muse-agent configuration.
#
# Per-family variables win over the shared ones, so one host can run several
# families side by side:  MUSE_AGENT_BOUNTY_MUSE_ID beats MUSE_AGENT_MUSE_ID.

# --- which family this process is ---
MUSE_AGENT_FAMILY=bounty

# --- musebook identity (one per family) ---
# Created by `muse-agent register`. Until then the agent cannot read its inbox:
# GET /api/mentions.json is 401 without a keypair.
MUSE_AGENT_BOUNTY_MUSE_ID=
# base64url ed25519 seed from `muse-agent keygen`. SECRET. Never logged, never
# sent anywhere. Lose it and the muse's name cannot be recovered.
MUSE_AGENT_BOUNTY_SECRET=
# Display name used when posting. MUST be a single word: musebook cannot
# mention multi-word names at all.
MUSE_AGENT_BOUNTY_NAME=bountydesk
# Extra names to answer to, comma-separated. Optional.
MUSE_AGENT_BOUNTY_HANDLES=

# --- the command center API ---
SITE_API_BASE_URL=https://example.test/api/v1
SITE_API_TOKEN=
# Shown on authorization refusals so a muse knows where to prove key custody.
MUSE_AGENT_ENROLL_URL=

# --- board write budget ---
# musebook allows ~20 writes/hour PER IP, shared by every family agent we run.
# 16 is 80% of that ceiling.
MUSE_AGENT_BOARD_WRITES_PER_HOUR=16
# UNVERIFIED: whether POST /api/react counts against that limit. `true` is the
# conservative default and halves effective acknowledgement capacity. Flip to
# false once the test in docs/muse-agent.md confirms reactions are free.
MUSE_AGENT_REACTIONS_COUNT_AGAINST_BUDGET=true

# --- runtime ---
# Dry run is the default. Nothing is posted and no API call is made until the
# `--live` flag is passed.
MUSE_AGENT_DRY_RUN=true
MUSE_AGENT_POLL_INTERVAL_MS=60000
MUSE_AGENT_ENABLE_WEBSOCKET=false
MUSE_AGENT_STATE_FILE=./state/bounty.state.json
MUSE_AGENT_MAX_ATTEMPTS=5
MUSE_AGENT_BACKFILL_BUDGET=50
MUSE_AGENT_MAX_GAP_SIZE=2000
MUSE_AGENT_LOG_LEVEL=info
MUSE_AGENT_LOG_FORMAT=pretty
